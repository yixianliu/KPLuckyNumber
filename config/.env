# ==========================================
# KPLuckyNumber 本地开发环境变量
# ==========================================

# ---------- 数据库配置 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=lucky_number
DB_CHARSET=utf8mb4

# ---------- 连接池配置 ----------
DB_POOL_MIN_CONNECTIONS=2
DB_POOL_MAX_CONNECTIONS=10
DB_POOL_BLOCKING=true

# ---------- AGNES AI API 配置（对齐 api.txt 官方规范）----------
# 端点：https://api.agnes-ai.cn/v1/chat/completions
# 认证：Authorization: Bearer <API_KEY>
AGNES_API_URL=https://api.agnes-ai.cn/v1/chat/completions
# 保留现有本地密钥；如需切换请到 config.py 或 api.txt 参考
AGNES_API_KEY=sk-nXcJVCLluIbranCCHGO9MIrmBFvhRl5E4goKMrsVt0F0fkFm
# 默认模型（api.txt 推荐）；如需回退可改为 agnes-2.5-flash
AGNES_MODEL_NAME=agnes-3.0-flash
# 主模型不可用时自动降级的备份模型
AGNES_BACKUP_MODEL=agnes-2.5-flash
AGNES_TIMEOUT=60
AGNES_TEMPERATURE=0.7
AGNES_MAX_TOKENS=2048
AGNES_TOP_P=1.0
AGNES_STREAM=false
AGNES_MAX_RETRIES=3
AGNES_RETRY_BACKOFF=0.5
AGNES_POOL_CONNECTIONS=5
AGNES_POOL_MAXSIZE=10
AGNES_RESPONSE_FORMAT=json_object

# ---------- 爬虫配置 ----------
SPIDER_PAGES=10
SPIDER_TIMEOUT=15
SPIDER_RETRY_COUNT=3
SPIDER_DELAY_MIN=3
SPIDER_DELAY_MAX=6

# ---------- Redis 缓存配置 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=kpluckynumber:pl5:

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=30