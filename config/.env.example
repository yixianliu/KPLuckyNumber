# ==========================================
# KPLuckyNumber 环境变量配置模板
# 复制为 .env 并填入真实值
# 规范参考：D:\PythonProject\api\api.txt
# ==========================================

# ---------- 数据库配置 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=lucky_number
DB_CHARSET=utf8mb4

# ---------- 连接池配置 ----------
DB_POOL_MIN_CONNECTIONS=2
DB_POOL_MAX_CONNECTIONS=10
DB_POOL_BLOCKING=true

# ---------- AGNES AI API 配置（对齐 api.txt）----------
# 端点：https://api.agnes-ai.cn/v1/chat/completions
# 认证：Authorization: Bearer <API_KEY>
AGNES_API_URL=https://api.agnes-ai.cn/v1/chat/completions
AGNES_API_KEY=your_agnes_api_key_here
# 默认模型（api.txt 推荐版本）；如需切回旧版可设为 agnes-2.5-flash
AGNES_MODEL_NAME=agnes-3.0-flash
# 主模型不可用（404/5xx 重试耗尽）时自动降级的备份模型
AGNES_BACKUP_MODEL=agnes-2.5-flash
# 请求超时（秒）
AGNES_TIMEOUT=60
# 采样温度（0.0-2.0）；分析类任务建议 0.5-0.7
AGNES_TEMPERATURE=0.7
# 单次调用最大输出 token（默认 2048；调用点可自行 override 至 8000）
AGNES_MAX_TOKENS=2048
# 采样核概率（一般 1.0 即不启用，需模型支持）
AGNES_TOP_P=1.0
# 是否启用流式输出（本项目当前不用）
AGNES_STREAM=false
# HTTP 重试：总次数 + 退避因子（Retry 会自动处理 429/5xx）
AGNES_MAX_RETRIES=3
AGNES_RETRY_BACKOFF=0.5
# 连接池：并发连接池数量 + 单池最大连接数
AGNES_POOL_CONNECTIONS=5
AGNES_POOL_MAXSIZE=10
# 请求 JSON 输出模式：json_object | false（关闭则模型自由输出，需 json_repair 容错解析）
AGNES_RESPONSE_FORMAT=json_object

# ---------- 爬虫配置 ----------
SPIDER_PAGES=10
SPIDER_TIMEOUT=15
SPIDER_RETRY_COUNT=3
SPIDER_DELAY_MIN=3
SPIDER_DELAY_MAX=6

# ---------- Redis 缓存配置 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=kpluckynumber:pl5:

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_DIR=logs

# ---------- 特征工程缓存配置（v5.2 ALG-04：指纹复用）----------
# 启用特征指纹缓存（怀疑缓存异常时可置 false 一键回退全量重算）
FEATURE_CACHE_ENABLED=true
# 进程内 LRU 缓存容量（跨 P5Features 实例共享，默认 8）
FEATURE_CACHE_CAPACITY=8

# ---------- AGNES 运行参数（config.py AGNES_API_CONFIG 消费）----------
# 历史样本期数范围（用于 AI 辅助解读输入规模）
AGNES_HISTORY_PERIODS_MIN=50
AGNES_HISTORY_PERIODS=200
AGNES_HISTORY_PERIODS_MAX=500
# 是否注入目标期号（AI 解读时把 target_issue 一并交给模型）
AGNES_INJECT_TARGET_ISSUE=false
# 提示词版本控制（AI 解读模板）
AGNES_PROMPT_HONESTY=honest_v2
AGNES_PROMPT_FEW_SHOT=false
# 解析结果不合法时是否重试
AGNES_RETRY_ON_INVALID=true

# ---------- AI 调用预算（v5.2 ALG-02：分级超时 + run 级熔断）----------
# 单次 HTTP 读超时第一级（响应慢但未死时快速切断）
AI_SOFT_TIMEOUT=20
# 单次 _call_ai_model 总墙钟硬上限（A22：30s）
AI_HARD_TIMEOUT=30
# run 级预算熔断开关（false = 仅保留单次硬上限、关闭 run 级熔断）
ENABLE_AI_BUDGET=true
# 单期 run 内 AI 调用次数上限（与 AI_HARD_TIMEOUT 相乘构成 run 级预算，默认 2）
AI_PER_RUN_MAX_CALLS=2

# ---------- 数据资产管理（config.py DATA_ASSET_CONFIG 消费）----------
# AI 报告压缩（历史 AI 解读报告压缩/保留策略）
DATA_AI_REPORT_COMPACTION=true
# 自动清理开关（数据目录清理）
DATA_ENABLE_AUTO_CLEANUP=true
# 清理 DRY-RUN（只打印不执行）
DATA_CLEANUP_DRY_RUN=false
# 孤儿文件检查
DATA_ORPHAN_CHECK=true

# ---------- 实验追踪（config.py 实验记录开关）----------
EXPERIMENT_TRACKING_ENABLED=true
EXPERIMENT_TRACKING_LOG=experiments.log
EXPERIMENT_TRACKING_GIT_HASH=HEAD

# ---------- 遗传算法调优（config.py GA 配置消费）----------
GA_POPULATION_SIZE=50
GA_GENERATIONS=30
GA_CROSSOVER=0.8
GA_MUTATION_RATE=0.05

# ---------- 功能开关（config.py 消费）----------
# 模型反馈闭环（预测结果回流训练）
MODEL_FEEDBACK_ENABLE=true
# 在线学习结果写回数据库
ONLINE_LEARNER_WRITEBACK=true
# 性能监控开关（gui 性能采集）
PERF_MONITOR_ENABLE=true
# 结果验证器开关
RESULT_VERIFIER_ENABLE=true
# 搜索结果后端（数据库/内存）
SEARCH_BACKEND=database
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=30

# ---------- 版本信息 ----------
# 版本号由 version.py 统一管理，此处仅作参考
APP_VERSION=3.68
