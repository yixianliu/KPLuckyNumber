# ==========================================
# KPLuckyNumber 环境变量配置模板
# 复制为 .env 并填入真实值
# 规范参考：D:\PythonProject\api\api.txt
# ==========================================

# ---------- 数据库配置 ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=lucky_number
DB_CHARSET=utf8mb4

# ---------- 连接池配置 ----------
DB_POOL_MIN_CONNECTIONS=2
DB_POOL_MAX_CONNECTIONS=10
DB_POOL_BLOCKING=true

# ---------- AGNES AI API 配置（对齐 api.txt）----------
# 端点：https://api.agnes-ai.cn/v1/chat/completions
# 认证：Authorization: Bearer <API_KEY>
AGNES_API_URL=https://api.agnes-ai.cn/v1/chat/completions
AGNES_API_KEY=your_agnes_api_key_here
# 默认模型（api.txt 推荐版本）；如需切回旧版可设为 agnes-2.5-flash
AGNES_MODEL_NAME=agnes-3.0-flash
# 主模型不可用（404/5xx 重试耗尽）时自动降级的备份模型
AGNES_BACKUP_MODEL=agnes-2.5-flash
# 请求超时（秒）
AGNES_TIMEOUT=60
# 采样温度（0.0-2.0）；分析类任务建议 0.5-0.7
AGNES_TEMPERATURE=0.7
# 单次调用最大输出 token（默认 2048；调用点可自行 override 至 8000）
AGNES_MAX_TOKENS=2048
# 采样核概率（一般 1.0 即不启用，需模型支持）
AGNES_TOP_P=1.0
# 是否启用流式输出（本项目当前不用）
AGNES_STREAM=false
# HTTP 重试：总次数 + 退避因子（Retry 会自动处理 429/5xx）
AGNES_MAX_RETRIES=3
AGNES_RETRY_BACKOFF=0.5
# 连接池：并发连接池数量 + 单池最大连接数
AGNES_POOL_CONNECTIONS=5
AGNES_POOL_MAXSIZE=10
# 请求 JSON 输出模式：json_object | false（关闭则模型自由输出，需 json_repair 容错解析）
AGNES_RESPONSE_FORMAT=json_object

# ---------- 爬虫配置 ----------
SPIDER_PAGES=10
SPIDER_TIMEOUT=15
SPIDER_RETRY_COUNT=3
SPIDER_DELAY_MIN=3
SPIDER_DELAY_MAX=6

# ---------- Redis 缓存配置 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=kpluckynumber:pl5:

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=30

# ---------- 版本信息 ----------
# 版本号由 version.py 统一管理，此处仅作参考
APP_VERSION=3.68
